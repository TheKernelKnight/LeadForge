{
  "framework": "nextjs",
  "buildCommand": "cd apps/web && npm run vercel-build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm install --prefix apps/web && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-api-url.com/api/$1"
    }
  ]
}
